---
// Every command and its arguments, rendered from askround.cli.build_parser() by
// scripts/reference.py.
import reference from "../data/reference.generated.json";
---

{
  reference.commands.map((command) => (
    <section>
      <h3 id={command.name}>
        <code>askround {command.name}</code>
      </h3>
      <p>{command.help}</p>
      <table>
        <thead>
          <tr>
            <th scope="col">Argument</th>
            <th scope="col">What it does</th>
          </tr>
        </thead>
        <tbody>
          {command.arguments.map((arg) => (
            <tr>
              <td>
                <code>{arg.name}</code>
              </td>
              <td>
                {arg.help}
                {arg.choices.length > 0 ? ` (one of: ${arg.choices.join(", ")})` : ""}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))
}
